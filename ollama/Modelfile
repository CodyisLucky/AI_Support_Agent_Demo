# The local support model. Build it once in WSL:
#   ollama create lumen-qwen -f ollama/Modelfile
# then set AGENT_MODEL=lumen-qwen in agent.env.
#
# Ollama's default 4096-token window is smaller than the system prompt, tools,
# a doc or two, and the chat history together, and Ollama silently drops the
# overflow. The OpenAI-compatible endpoint cannot change the window per request,
# so it is set here. 16384 adds about 1 GB of VRAM.
FROM qwen2.5:7b
PARAMETER num_ctx 16384
# Lower than the default so the same question gets the same answer.
PARAMETER temperature 0.3
