# Candidate local model, compared with the default lumen-gemma. It followed the
# shop's rules in 23 of 30 test replies; see docs/local-model-tests.md.
# Rebuild with:
#   ollama pull llama3.1:8b
#   ollama create lumen-llama -f ollama/lumen-llama.Modelfile
# See lumen-gemma.Modelfile for why the context window is raised.
# Sampling stays at the publisher's defaults.
FROM llama3.1:8b
PARAMETER num_ctx 16384
