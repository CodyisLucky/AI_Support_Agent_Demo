# Support agent switches. Copy to agent.env (gitignored) and edit.
# The shop re-reads this file on every chat message: no restart needed.
# API keys do NOT go here; they go in .env so this file is safe to show on screen.

# Who answers: anthropic | ollama | openai | gemini
AGENT_PROVIDER=anthropic

# The model for that provider. Change it whenever AGENT_PROVIDER changes.
# Claude options: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5
# Ollama: lumen-qwen (build it once with: ollama create lumen-qwen -f ollama/Modelfile)
AGENT_MODEL=claude-opus-5-5

# Claude effort: low | medium | high (low suits short support chats). Ollama ignores it.
AGENT_EFFORT=low

# Show provider, model, time, tokens, cost, and lookups under each reply
AGENT_SHOW_DETAILS=true

# Where handoffs send the shopper. Email is always offered.
SUPPORT_EMAIL=help@lumenbeauty.example
# Optional live chat link (https://...). Leave empty to offer email only.
LIVE_CHAT_URL=

# Local model server (Ollama in WSL). Keep it on 127.0.0.1.
OLLAMA_URL=http://127.0.0.1:11434

# Safeguards: keep the chat on shopping and cap what it can cost. See docs/errors/509.md.
AGENT_MAX_MESSAGE_CHARS=1000
AGENT_MAX_MESSAGES_PER_CHAT=30
AGENT_RATE_PER_MINUTE=6
AGENT_RATE_PER_HOUR_PER_IP=60
AGENT_MAX_TOKENS_PER_REPLY=60000
AGENT_OFF_TOPIC_LIMIT=3
# Daily spend caps in US dollars (the shop's estimate). 0 turns a cap off.
AGENT_DAILY_BUDGET_USD=5
AGENT_VISITOR_DAILY_BUDGET_USD=1
# Only set true behind a proxy you control that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
